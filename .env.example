# ===========================================================================
# CONFIGURACIÓN DE ENTORNO — Tiro Federal Rufino
# Copiar este archivo a ".env" y completar los valores.
# ===========================================================================

# --- Base de datos ---
# DESARROLLO LOCAL (SQLite, archivo local):
PRISMA_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
#
# PRODUCCIÓN (PostgreSQL, ej. Neon). Reemplazar las dos líneas de arriba por:
# PRISMA_PROVIDER="postgresql"
# DATABASE_URL="postgres://usuario:password@host/basededatos?sslmode=require"

# --- NextAuth (autenticación) ---
# Generar un secret con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-un-secret-seguro"
# En local: http://localhost:3000  | En producción: la URL pública de la app
NEXTAUTH_URL="http://localhost:3000"

# --- Mercado Pago ---
# Credenciales del panel: https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- URL pública de la app (para back_urls y webhooks de Mercado Pago) ---
# En local: http://localhost:3000  | En producción: https://tu-dominio.vercel.app
APP_URL="http://localhost:3000"

# --- Valor de la cuota mensual por defecto (en pesos) ---
CUOTA_MENSUAL_DEFAULT="5000"
