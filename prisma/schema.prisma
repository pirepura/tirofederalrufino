// Esquema de base de datos — Tiro Federal Rufino
// Motor: PostgreSQL (Neon) en local y producción.
//
// Nota: los estados se guardan como String y se validan a nivel de aplicación
// con las constantes de src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL para producción (Neon) y también en local.
  // La conexión concreta se define en DATABASE_URL (.env).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y autenticación
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          String   @default("SOCIO") // ADMIN | SOCIO
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación 1:1 con el perfil de socio (cuando el rol es SOCIO)
  socio Socio?
}

// ---------------------------------------------------------------------------
// Socios
// ---------------------------------------------------------------------------

model Socio {
  id            String   @id @default(cuid())
  // Número de socio (correlativo, visible para el club)
  numeroSocio   Int      @unique
  dni           String   @unique
  nombre        String
  apellido      String
  telefono      String?
  direccion     String?
  fechaAlta     DateTime @default(now())
  estado        String   @default("ACTIVO") // ACTIVO | INACTIVO | SUSPENDIDO
  observaciones String?

  // Categoría del socio (define el precio de la cuota)
  categoriaId String?
  categoriaRef Categoria? @relation(fields: [categoriaId], references: [id])

  // Débito automático (suscripción de Mercado Pago / preapproval)
  mpPreapprovalId   String? // id de la suscripción en Mercado Pago
  suscripcionEstado String? // "activa" | "pausada" | "cancelada" | null (sin débito)
  suscripcionMonto  Float?  // monto con el que se creó la suscripción

  // Cuenta de acceso del socio
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cuotas     Cuota[]
  alquileres AlquilerLinea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Categorías de socio (cada una con su valor de cuota mensual)
// El precio se define una vez por categoría y se cambia en un solo lugar.
// ---------------------------------------------------------------------------

model Categoria {
  id           String  @id @default(cuid())
  nombre       String  @unique
  cuotaMensual Float    @default(0)
  activa       Boolean  @default(true)

  socios Socio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cuotas y pagos
// ---------------------------------------------------------------------------

model Cuota {
  id      String @id @default(cuid())
  socioId String
  socio   Socio  @relation(fields: [socioId], references: [id], onDelete: Cascade)

  // Período que cubre la cuota (mes/año)
  periodoMes       Int // 1-12
  periodoAnio      Int
  descripcion      String   @default("Cuota mensual")
  monto            Float
  fechaVencimiento DateTime
  estado           String   @default("PENDIENTE") // PENDIENTE | PAGADA | VENCIDA | ANULADA | EN_REVISION

  // Datos del pago (si fue pagada)
  fechaPago  DateTime?
  metodoPago String? // "mercadopago" | "efectivo" | "transferencia"

  // Comprobante de pago informado por el socio (pago por otro medio, a verificar).
  // El archivo se guarda como data URL base64 y se borra al confirmar el pago.
  comprobanteData        String? // data URL (imagen o PDF)
  comprobanteTipo        String? // mime type: image/jpeg, application/pdf, etc.
  comprobanteInformadoEn DateTime?
  metodoPagoInformado    String? // "transferencia" | "efectivo" | "deposito" | ...

  // Referencias de Mercado Pago
  mpPreferenceId String?
  mpPaymentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Evita duplicar la cuota de un mismo período para el mismo socio
  @@unique([socioId, periodoMes, periodoAnio])
}

// ---------------------------------------------------------------------------
// Módulo de alquiler de líneas de tiro (PREPARADO PARA EL FUTURO)
// La estructura está definida para desarrollo posterior. La UI completa
// se implementará más adelante.
// ---------------------------------------------------------------------------

model LineaTiro {
  id          String  @id @default(cuid())
  numero      Int     @unique
  nombre      String
  descripcion String?
  activa      Boolean @default(true)
  // Precio por turno/hora
  precioTurno Float   @default(0)

  alquileres AlquilerLinea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlquilerLinea {
  id      String    @id @default(cuid())
  socioId String
  socio   Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  lineaId String
  linea   LineaTiro @relation(fields: [lineaId], references: [id], onDelete: Cascade)

  fechaInicio DateTime
  fechaFin    DateTime
  monto       Float
  estado      String   @default("RESERVADO") // RESERVADO | CONFIRMADO | CANCELADO | COMPLETADO

  mpPreferenceId String?
  mpPaymentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Solicitudes de inscripción de socios (formulario público firmado)
// ---------------------------------------------------------------------------

model SolicitudInscripcion {
  id String @id @default(cuid())

  // Datos personales del solicitante
  nombreCompleto  String
  dni             String
  fechaNacimiento DateTime
  domicilio       String
  email           String
  celular         String

  // Vinculación previa con la asociación (opcional)
  fueSocio         Boolean @default(false)
  anioAsociado     Int?
  categoriaPrevia  String?
  primerPeriodo    String?

  // Firma dibujada (imagen PNG en base64 data URL) + declaración jurada
  firmaDataUrl     String
  aceptaDeclaracion Boolean @default(false)

  // Credenciales elegidas por el solicitante (para crear su cuenta al aprobar)
  passwordHash String

  // Estado de la solicitud
  estado          String   @default("PENDIENTE") // PENDIENTE | APROBADA | RECHAZADA
  motivoRechazo   String?
  // Referencia al socio creado cuando se aprueba
  socioIdCreado   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Auditoría: registro de acciones del sistema (quién hizo qué y cuándo)
// ---------------------------------------------------------------------------

model RegistroAuditoria {
  id String @id @default(cuid())

  // Quién realizó la acción (puede ser el sistema, sin usuario)
  usuarioId     String?
  usuarioNombre String? // se guarda el nombre/email para conservarlo aunque el usuario se borre
  usuarioRol    String? // ADMIN | SOCIO | SISTEMA

  accion  String // constante de ACCION_AUDITORIA (ej. SOCIO_CREADO)
  entidad String? // tipo de entidad afectada (socio, cuota, categoria, etc.)
  entidadId String? // id de la entidad afectada
  detalle String? // descripción legible de lo que pasó

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([accion])
  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Rifas / sorteos (venta pública de números, sorteo por Lotería Nacional)
// ---------------------------------------------------------------------------

model Rifa {
  id          String  @id @default(cuid())
  slug        String  @unique // identificador para la URL pública
  titulo      String
  descripcion String?

  // Configuración de números
  cantidadNumeros Int // cuántos números tiene la rifa
  cifras          Int   @default(4) // 1 a 4 (000..9999); para mostrar con ceros a la izquierda
  precioNumero    Float

  estado String @default("activa") // activa | finalizada

  premios PremioRifa[]
  numeros NumeroRifa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PremioRifa {
  id       String @id @default(cuid())
  rifaId   String
  rifa     Rifa   @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  posicion Int // 1 | 2 | 3
  titulo   String
  // Foto del premio (base64 data URL). Se borra al finalizar la rifa.
  fotoData String?
  fotoTipo String?

  @@unique([rifaId, posicion])
}

model NumeroRifa {
  id     String @id @default(cuid())
  rifaId String
  rifa   Rifa   @relation(fields: [rifaId], references: [id], onDelete: Cascade)
  numero Int

  estado String @default("disponible") // disponible | en_proceso | vendido

  // Datos del comprador (cuando se vende)
  compradorNombre   String?
  compradorApellido String?
  compradorTelefono String?

  // Pago
  mpPreferenceId String?
  mpPaymentId    String?
  fechaPago      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rifaId, numero])
  @@index([estado])
}
